rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // sessions collection - created by authenticated teachers
    match /sessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.active is bool;

      // teacher can read/update/delete own sessions
      allow read, update, delete: if request.auth != null
        && resource.data.owner == request.auth.uid;

      // attendees subcollection
      match /attendees/{attendeeId} {
        // anyone (no auth) can create attendance but validate fields
        allow create: if request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 200
          && request.resource.data.grade is string
          && request.resource.data.grade.size() < 50
          && request.resource.data.section is string
          && request.resource.data.section.size() < 50
          && request.resource.data.createdAt != null;

        // only owner (teacher) can read attendees
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.owner == request.auth.uid;

        // nobody can update or delete attendees (teacher may want delete later; restrict for now)
        allow update, delete: if false;
      }
    }

    // fallback - deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
